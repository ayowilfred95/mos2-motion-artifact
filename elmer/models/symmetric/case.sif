! Check: symmetric 25 um PI / films / 25 um PI
! 2D plane strain, linear elasticity, pure bending by a force-free linear end traction.
! Generated by elmer/make_models.py - edit there, not here.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "symmetric"
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
End

Constants
End

Body 1
  Name = "PI"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Body 2
  Name = "Au"
  Target Bodies(1) = 2
  Equation = 1
  Material = 2
End

Body 3
  Name = "MoS2"
  Target Bodies(1) = 3
  Equation = 1
  Material = 3
End

Body 4
  Name = "Al2O3"
  Target Bodies(1) = 4
  Equation = 1
  Material = 4
End

Body 5
  Name = "PI"
  Target Bodies(1) = 5
  Equation = 1
  Material = 5
End

Equation 1
  Name = "Linear elasticity (plane strain)"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = Linear elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 2 Displacement
  Plane Stress = False
  Displace Mesh = False
  Calculate Strains = True
  Calculate Stresses = True
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
End

Solver 2
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = "lines.dat"
  Polyline Coordinates(4,2) = Real 1.0e-9 0.0  1.0e-9 5.0055650000000006e-05  50.0e-6 0.0  50.0e-6 5.0055650000000006e-05
  Polyline Divisions(2) = 2000 2000
End

Solver 3
  Equation = ResultOutput
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "symmetric"
  Vtu Format = True
  Ascii Output = True
End

Material 1
  Name = "PI"
  Youngs Modulus = 2500000000.0
  Poisson Ratio = 0.34
  Density = 1420
End

Material 2
  Name = "Au"
  Youngs Modulus = 79000000000.0
  Poisson Ratio = 0.44
  Density = 19300
End

Material 3
  Name = "MoS2"
  Youngs Modulus = 270000000000.0
  Poisson Ratio = 0.27
  Density = 5060
End

Material 4
  Name = "Al2O3"
  Youngs Modulus = 180000000000.0
  Poisson Ratio = 0.24
  Density = 3950
End

Material 5
  Name = "PI"
  Youngs Modulus = 2500000000.0
  Poisson Ratio = 0.34
  Density = 1420
End

! moment load: traction = s*(y - y_mid), s = 1.130710e+11 Pa/m, y_mid = 2.5027825000000003e-05 m
Boundary Condition 1
  Name = "right end: moment"
  Target Boundaries(1) = 2
  Force 1 = Variable Coordinate 2
    Real MATC "113071015206.26346*(tx-2.5027825000000003e-05)"
End

Boundary Condition 2
  Name = "x = 0: symmetry plane (channel centre)"
  Target Boundaries(1) = 4
  Displacement 1 = 0.0
End

Boundary Condition 3
  Name = "pin at x=0, bottom (no vertical rigid motion)"
  Target Coordinates(1,2) = 0.0 0.0
  Displacement 2 = 0.0
End
