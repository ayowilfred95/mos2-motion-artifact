! Rigid island strip, skin_sliding, island=yes
! Generated by elmer/make_models.py - edit there, not here.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "island_skin_sliding_with"
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
End

Body 1
  Name = "PDMS"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Body 2
  Name = "rigid island"
  Target Bodies(1) = 2
  Equation = 1
  Material = 2
End

Body 3
  Name = "PI"
  Target Bodies(1) = 3
  Equation = 1
  Material = 3
End

Body 4
  Name = "PDMS beside the island"
  Target Bodies(1) = 4
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Linear elasticity (plane strain)"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = Linear elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 2 Displacement
  Plane Stress = False
  Displace Mesh = False
  Calculate Strains = True
  Calculate Stresses = True
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
End

Solver 2
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = "lines.dat"
  ! 1: through the thickness at the channel (x = 0); 2, 3: along the bottom and top of the PI film
  Polyline Coordinates(6,2) = Real 1.0e-9 -0.0001  1.0e-9 2.5e-05  0.0 1.0e-9  0.005 1.0e-9  0.0 2.4999000000000002e-05  0.005 2.4999000000000002e-05
  Polyline Divisions(3) = 2000 4000 4000
End

Solver 3
  Equation = ResultOutput
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "island_skin_sliding_with"
  Vtu Format = True
  Ascii Output = True
End

Material 1
  Name = "PDMS"
  Youngs Modulus = 2000000.0
  Poisson Ratio = 0.49
  Density = 965
End

Material 2
  Name = "rigid island"
  Youngs Modulus = 70000000000.0
  Poisson Ratio = 0.22
  Density = 2500
End

Material 3
  Name = "PI"
  Youngs Modulus = 2500000000.0
  Poisson Ratio = 0.34
  Density = 1420
End

! skin-imposed curvature kappa = 40.0 1/m on the PDMS underside (skin_sliding)
Boundary Condition 1
  Name = "PDMS underside follows the skin arc"
  Target Boundaries(1) = 1
  Displacement 2 = Variable Coordinate 1
    Real MATC "-0.5*40.0*tx^2"
End

Boundary Condition 2
  Name = "x = 0: symmetry plane (channel centre)"
  Target Boundaries(1) = 4
  Displacement 1 = 0.0
End
