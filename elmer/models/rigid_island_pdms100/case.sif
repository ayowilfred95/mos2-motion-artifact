! Rigid island: 3 mm x 20 um island (70 GPa) in 100 um PDMS under 25 um PI
! Generated by elmer/make_models.py - edit there, not here.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "rigid_island_pdms100"
  Results Directory "results"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 2D
  Simulation Type = Steady state
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
End

Body 1
  Name = "PDMS"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Body 2
  Name = "rigid island"
  Target Bodies(1) = 2
  Equation = 1
  Material = 2
End

Body 3
  Name = "PI"
  Target Bodies(1) = 3
  Equation = 1
  Material = 3
End

Body 4
  Name = "PDMS beside the island"
  Target Bodies(1) = 4
  Equation = 1
  Material = 1
End

Equation 1
  Name = "Linear elasticity (plane strain)"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = Linear elasticity
  Procedure = "StressSolve" "StressSolver"
  Variable = -dofs 2 Displacement
  Plane Stress = False
  Displace Mesh = False
  Calculate Strains = True
  Calculate Stresses = True
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
End

Solver 2
  Equation = SaveLine
  Procedure = "SaveData" "SaveLine"
  Filename = "lines.dat"
  ! 1: through the thickness at the channel (x = 0); 2, 3: along the bottom and top of the PI film
  Polyline Coordinates(6,2) = Real 1.0e-9 -0.0001  1.0e-9 2.5e-05  0.0 1.0e-9  0.005 1.0e-9  0.0 2.4999000000000002e-05  0.005 2.4999000000000002e-05
  Polyline Divisions(3) = 2000 4000 4000
End

Solver 3
  Equation = ResultOutput
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "rigid_island_pdms100"
  Vtu Format = True
  Ascii Output = True
End

Material 1
  Name = "PDMS"
  Youngs Modulus = 2000000.0
  Poisson Ratio = 0.49
  Density = 965
End

Material 2
  Name = "rigid island"
  Youngs Modulus = 70000000000.0
  Poisson Ratio = 0.22
  Density = 2500
End

Material 3
  Name = "PI"
  Youngs Modulus = 2500000000.0
  Poisson Ratio = 0.34
  Density = 1420
End

! moment load: traction = s*(y - y_mid), s = 1.130710e+11 Pa/m, y_mid = 1.25e-05 m
Boundary Condition 1
  Name = "right end: moment"
  Target Boundaries(1) = 2
  Force 1 = Variable Coordinate 2
    Real MATC "113071008593.39665*(tx-(1.25e-05))"
End

Boundary Condition 2
  Name = "x = 0: symmetry plane (channel centre)"
  Target Boundaries(1) = 4
  Displacement 1 = 0.0
End

Boundary Condition 3
  Name = "pin at x=0, bottom (no vertical rigid motion)"
  Target Coordinates(1,2) = 0.0 -0.0001
  Displacement 2 = 0.0
End
